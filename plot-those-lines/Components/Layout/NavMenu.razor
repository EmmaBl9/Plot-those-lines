<!--ETML
Auteur : [Ton Nom]
Date   : [Date du jour]
Description : Classe principale gérant l’importation, le filtrage et l’affichage graphique des fichiers CSV.-->

@inject NavigationManager NavManager
@inject DateFilter DateFilter

<div class="DateFilter">
    <h5>Filtrer par années :</h5>
    <div class="filter-inputs">
        <label>
            De : 
            <input 
                type="number"
                placeholder="Année début"
                @bind="startYear"
                min="1900"
                max="2100" />
        </label>
        <label>
            À : 
            <input 
                type="number"
                placeholder="Année fin"
                @bind="endYear"
                min="1900"
                max="2100" />
        </label>
    </div>
    <div class="filter-buttons">
        <button class="btn btn-primary btn-sm" @onclick="ApplyFilter">Appliquer</button>
        <button class="btn btn-secondary btn-sm" @onclick="ClearFilter">Réinitialiser</button>
    </div>
</div>

@code {
    /// <summary>
    /// Année de début du filtre.
    /// </summary>
    private int? startYear;

    /// <summary>
    /// Année de fin du filtre.
    /// </summary>
    private int? endYear;

    /// <summary>
    /// Applique le filtre d’années défini par l’utilisateur.
    /// </summary>
    private void ApplyFilter()
    {
        DateFilter.SetDateRange(startYear, endYear);
    }

    /// <summary>
    /// Réinitialise le filtre des années.
    /// </summary>
    private void ClearFilter()
    {
        startYear = null;
        endYear = null;
        DateFilter.ClearFilter();
    }
}