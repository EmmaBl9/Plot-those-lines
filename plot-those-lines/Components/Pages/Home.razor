@page "/"

<h3>Démographie Suisse - Ton graphique</h3>

<!-- Ajouter un fichier csv -->
<div class="Import">
    <label>Choisir une nouvelle donnée (CSV):</label>
    <InputFile OnChange="OnInputFileChange" />
</div>

<!-- Affichage des fichiers ajoutés -->
@if (UploadedFiles.Any())
{
    <p>Fichiers CSV ajoutés :</p>
    <ul>
        @foreach (var fileName in UploadedFiles)
        {
            <li>@fileName</li>
        }
    </ul>
}

<!-- Graphique ApexCharts -->
<div class="chart" style="height:350px; width:100%;">
    <ApexChart TItem="DataPoint" Title="Graphiqe">
        <ApexPointSeries TItem="DataPoint" Items="DataPoints" Name="Population" SeriesType="SeriesType.Line" XValue="e => e.Label" YValue="e => e.Value" />
    </ApexChart>
</div>

@code {

    // Liste des points de données initialement vide
    private List<DataPoint> DataPoints { get; set; } = new();

    // Liste des noms de fichiers CSV chargés
    private List<string> UploadedFiles = new();

    // méthode pour gérer le chargement du fichier
    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Ajouter le nom du fichier à la liste des fichiers chargés
        UploadedFiles.Add(file.Name);

        using var stream = file.OpenReadStream();
        using var reader = new StreamReader(stream);
        var content = await reader.ReadToEndAsync();

        var lines = content
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        var dataPoints = lines
            .Skip(1)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .Select(l => l.Split(','))
            .Where(parts => parts.Length == 2)
            .Select(parts => new DataPoint
            {
                Label = parts[0],
                Value = int.TryParse(parts[1], out var val) ? val : 0
            }).ToList();

        // mettre à jour le graphique
        UpdateGraph(dataPoints);
    }

    // méthode pour mettre à jour le graphique
    private void UpdateGraph(List<DataPoint> data)
    {
        DataPoints = data;
        StateHasChanged();
    }

    // class pour les données
    public class DataPoint
    {
        public string Label { get; set; }
        public int Value { get; set; }
    }
}