@page "/"

<div style="width: 900px; height: 600px">
    <ApexChart TItem="MyData"
               Title="Sample Data">

        <ApexPointSeries TItem="MyData"
                         Items="Data"
                         Name="birth"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.Date"
                         YValue="e=> e.birth" />

        <ApexPointSeries TItem="MyData"
                         Items="Data"
                         Name="Death"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.Date"
                         YValue="e=> e.Death" />
    </ApexChart>
</div>


@code {
    private List<MyData> Data { get; set; } = new();
    private List<MyData> TempData { get; set; } = new();

    protected override void OnInitialized()
    {
        Data.AddRange(new[]
        {
            new MyData { Date = "2018", birth = 87851, Death = 67088 },
            new MyData { Date = "2019", birth = 86172, Death = 67780 },
            new MyData { Date = "2020", birth = 112, Death = 23 },
            new MyData { Date = "2021", birth = 136, Death = 31 },
            new MyData { Date = "2022", birth = 158, Death = 55 },
            new MyData { Date = "2023", birth = 120, Death = 21 },
            new MyData { Date = "2024", birth = 138, Death = 28 },
        });
    }

    public class MyData
    {
        public string Date { get; set; }
        public int birth { get; set; }
        public int Death { get; set; }
    }

}
